            "quote": [
              {
                "type": "paragraph",
                "text": "I am a small real estate investor. I used CostSegregation.com for a cost segregation analysis (for bonus depreciation). I think this software is a cost-effective approach and KBKG is credible. My CPA is okay with it. I am also satisfied with the customer service from KBKG.",
                "spans": [],
