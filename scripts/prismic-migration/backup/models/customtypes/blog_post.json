{
  "id": "blog_post",
  "label": "Blog Post",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "title",
          "placeholder": "",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "allowTargetBlank": true
        }
      },
      "date": {
        "type": "Date",
        "config": {
          "label": "date",
          "placeholder": ""
        }
      },
      "excerpt": {
        "type": "Text",
        "config": {
          "label": "excerpt",
          "placeholder": ""
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "featured_image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "body": {
        "type": "StructuredText",
        "config": {
          "label": "body",
          "placeholder": "",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "allowTargetBlank": true
        }
      },
      "faq_title": {
        "type": "Text",
        "config": {
          "label": "FAQ heading",
          "placeholder": "Frequently Asked Questions"
        }
      },
      "faqs": {
        "type": "Group",
        "config": {
          "label": "FAQs (shown as an accordion after the article)",
          "repeat": true,
          "fields": {
            "question": {
              "type": "Text",
              "config": {
                "label": "Question",
                "placeholder": ""
              }
            },
            "answer": {
              "type": "StructuredText",
              "config": {
                "label": "Answer",
                "placeholder": "",
                "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
                "allowTargetBlank": true
              }
            }
          }
        }
      },
      "after_faq": {
        "type": "StructuredText",
        "config": {
          "label": "Content after the FAQs (e.g. About the Author)",
          "placeholder": "",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "allowTargetBlank": true
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta title",
          "placeholder": "Shown in search results; defaults to the post title"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta description",
          "placeholder": "Defaults to the excerpt"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta image",
          "constraint": {},
          "thumbnails": []
        }
      }
    }
  },
  "status": true,
  "format": "custom"
}
