{
  "id": "testimonials",
  "type": "SharedSlice",
  "name": "Testimonials",
  "description": "Rating summary and review cards",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "Default",
      "imageUrl": "",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "title": {
          "type": "Text",
          "config": {
            "label": "Section title",
            "placeholder": ""
          }
        },
        "rating": {
          "type": "Number",
          "config": {
            "label": "Average rating",
            "placeholder": ""
          }
        },
        "review_count": {
          "type": "Number",
          "config": {
            "label": "Review count",
            "placeholder": ""
          }
        },
        "source_label": {
          "type": "Text",
          "config": {
            "label": "Source label",
            "placeholder": ""
          }
        },
        "review_cta_label": {
          "type": "Text",
          "config": {
            "label": "Review button label",
            "placeholder": "Leave a Review"
          }
        },
        "review_cta_link": {
          "type": "Link",
          "config": {
            "label": "Review button link",
            "placeholder": "",
            "select": null,
            "allowTargetBlank": true,
            "allowText": false,
            "repeat": false
          }
        },
        "custom_class": {
          "type": "Text",
          "config": {
            "label": "Custom CSS Class",
            "placeholder": "Optional CSS class name for custom styling this slice."
          }
        }
      },
      "items": {
        "quote": {
          "type": "StructuredText",
          "config": {
            "label": "Review",
            "placeholder": "",
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
            "allowTargetBlank": true
          }
        },
        "author": {
          "type": "Text",
          "config": {
            "label": "Author",
            "placeholder": ""
          }
        },
        "role": {
          "type": "Text",
          "config": {
            "label": "Role or location",
            "placeholder": ""
          }
        }
      }
    }
  ]
}