                "image_position": {
                    "type": "Select",
                    "config": {
                        "label": "Image position",
                        "placeholder": "",
                        "default_value": "right",
                        "options": [
                            "left",
                            "right"
                        ]
                    }
                },
                "custom_class": {
                    "type": "Text",
                    "config": {
                        "label": "Custom CSS Class",
                        "placeholder": "Optional CSS class name for custom styling this slice."
                    }
                }
            },
            "items": {}
        }
    ]
