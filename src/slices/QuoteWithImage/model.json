        {
            "id": "default",
            "name": "Default",
            "docURL": "...",
            "version": "initial",
            "description": "Default",
            "imageUrl": "",
            "primary": {
                "quote": {
                    "type": "StructuredText",
                    "config": {
                        "label": "Quote",
