{
  "id": "feature_grid",
  "type": "SharedSlice",
  "name": "FeatureGrid",
  "description": "Grid of feature cards",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "Text",
          "config": { "label": "Section title", "placeholder": "" }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Intro",
            "placeholder": "",
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
            "allowTargetBlank": true
          }
        },
        "cta_label": {
          "type": "Text",
          "config": { "label": "Card CTA label", "placeholder": "Learn More >" }
        },
        "back_label": {
          "type": "Text",
          "config": { "label": "Detail back button label", "placeholder": "Back to all benefits" }
        },
        "detail_eyebrow": {
          "type": "Text",
          "config": { "label": "Detail eyebrow", "placeholder": "Feature" }
        },
        "detail_panel_title": {
          "type": "Text",
          "config": { "label": "Detail panel heading", "placeholder": "What you get" }
        },
        "columns": {
          "type": "Group",
          "config": {
            "label": "Columns",
            "repeat": true,
            "fields": {
              "icon": {
                "type": "StructuredText",
                "config": {
                  "label": "Icon",
                  "placeholder": "",
                  "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
                  "allowTargetBlank": true
                }
              },
              "title": { "type": "Text", "config": { "label": "Title", "placeholder": "" } },
              "text": { "type": "Text", "config": { "label": "Text", "placeholder": "" } }
            }
          }
        },
        "custom_class": {
          "type": "Text",
          "config": {
            "label": "Custom CSS Class",
            "placeholder": "Optional CSS class name for custom styling this slice."
          }
        }
      },
      "items": {
        "icon": {
          "type": "Image",
          "config": { "label": "Icon", "constraint": {}, "thumbnails": [] }
        },
        "title": {
          "type": "Text",
          "config": { "label": "Card title", "placeholder": "" }
        },
        "text": {
          "type": "StructuredText",
          "config": {
            "label": "Card text",
            "placeholder": "Short description shown on the card",
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
            "allowTargetBlank": true
          }
        },
        "detail_intro": {
          "type": "Text",
          "config": { "label": "Detail intro", "placeholder": "Lead sentence shown in the detail view" }
        },
        "detail_list": {
          "type": "StructuredText",
          "config": {
            "label": "Detail list (\"What you get\" bullets)",
            "placeholder": "One bullet per line. Leave empty to use Detail paragraph.",
            "multi": "list-item,strong,em,hyperlink"
          }
        },
        "detail_paragraph": {
          "type": "StructuredText",
          "config": {
            "label": "Detail paragraph (used when list is empty)",
            "placeholder": "",
            "multi": "paragraph,strong,em,hyperlink",
            "allowTargetBlank": true
          }
        },
        "detail_note": {
          "type": "Text",
          "config": { "label": "Detail note (optional callout)", "placeholder": "" }
        }
      }
    }
  ]
}
